APP_ENV=development
DATABASE_URL=postgresql+psycopg://music:music_local_only@localhost:5432/music_room
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=music-room
JWT_AUDIENCE=music-room-mobile
CORS_ORIGINS=[]
MAIL_DIRECTORY=.dev-mail
EMAIL_LINK_BASE=http://localhost:8081
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GOOGLE_WEB_RETURN_URL=http://localhost:8081/

MUSIC_RATE_LIMIT=300

# make install derives POSTGRES_USER/PASSWORD/DB and CONTAINER_DATABASE_URL
# from DATABASE_URL in your private .env. Existing database passwords are preserved.
